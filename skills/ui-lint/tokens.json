{
  "$comment": "Sample tokens. Replace the values with your design system's. Colour names become the suggested CSS variable: text/primary suggests var(--text-primary).",
  "colour": {
    "text/primary": "#1e2328",
    "text/secondary": "#5a626a",
    "surface/default": "#ffffff",
    "surface/page": "#f5f6f7",
    "border/default": "#e2e5e8",
    "brand/default": "#2f6fde",
    "success/text": "#21603a",
    "warning/text": "#8a5a06",
    "danger/text": "#a8271d"
  },
  "spacing": [0, 2, 4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96, 128, 160],
  "type": {
    "rootPx": 16,
    "sizes": [12, 14, 16, 20, 24, 32],
    "weights": [400, 700]
  },
  "lint": {
    "forbiddenWords": [
      { "word": "simply", "reason": "if it were simple, nobody would read the hint" },
      { "word": "easily", "reason": "says nothing, and is wrong for the user who is stuck" },
      { "word": "oops", "reason": "an error message says what happened and what to do next" },
      { "word": "click here", "reason": "the link text names the destination", "instead": "the destination as link text" },
      { "word": "seamless" },
      { "word": "leverage", "instead": "use" },
      { "word": "please note" }
    ],
    "titleCaseAllow": ["Figma", "GitHub", "Claude"],
    "levels": {
      "raw-colour": "error",
      "off-scale-spacing": "error",
      "off-scale-font-size": "error",
      "off-scale-font-weight": "error",
      "transition-all": "warn",
      "title-case": "warn",
      "forbidden-word": "error"
    },
    "ignore": ["**/tokens.css", "**/*.stories.tsx"],
    "suspicious": { "minLines": 300 }
  }
}
